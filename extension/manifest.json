{
  "manifest_version": 3,
  "name": "Garden Archive",
  "version": "1.0.0",
  "description": "Keep any page, video, or track in your Garden archive — filed under a bed, plant, or fruit.",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://localhost:4000/*", "http://127.0.0.1:4000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Garden archive" },
  "options_page": "options.html"
}
